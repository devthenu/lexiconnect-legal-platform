#!/bin/bash
set -euxo pipefail
exec > >(tee /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

REGION="ap-south-1"
PARAM_PREFIX="/lexiconnect/${env}"
APP_DIR="/home/ec2-user/LexiConnect"
DEPLOY_DIR="$APP_DIR/deploy"

echo "==> Update OS"
yum update -y

echo "==> Install base packages"
yum install -y git awscli curl unzip

echo "==> Install Docker"
amazon-linux-extras install docker -y
systemctl enable docker
systemctl start docker
systemctl status docker --no-pager || true

echo "==> Install docker compose plugin"
mkdir -p /usr/local/lib/docker/cli-plugins

ARCH="$(uname -m)"
case "$ARCH" in
  x86_64)  COMPOSE_ARCH="x86_64" ;;
  aarch64) COMPOSE_ARCH="aarch64" ;;
  *) echo "Unsupported arch: $ARCH" ; exit 1 ;;
esac

COMPOSE_VERSION="v2.27.0"
curl -fsSL \
  "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-$COMPOSE_ARCH" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose

chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

echo "==> Verify docker + compose"
docker --version
docker compose version

echo "==> Allow ec2-user docker access"
usermod -aG docker ec2-user

echo "==> Clone repo"
cd /home/ec2-user
if [ ! -d "$APP_DIR" ]; then
  git clone ${repo_url} LexiConnect
fi
chown -R ec2-user:ec2-user "$APP_DIR"

echo "==> Fetch required SSM params"
DATABASE_URL="$(aws ssm get-parameter --name "$PARAM_PREFIX/DATABASE_URL" --with-decryption --query Parameter.Value --output text --region "$REGION")"
SECRET_KEY="$(aws ssm get-parameter --name "$PARAM_PREFIX/SECRET_KEY" --with-decryption --query Parameter.Value --output text --region "$REGION")"
FRONTEND_URL="$(aws ssm get-parameter --name "$PARAM_PREFIX/FRONTEND_URL" --query Parameter.Value --output text --region "$REGION" 2>/dev/null || true)"
ENV_VAL="$(aws ssm get-parameter --name "$PARAM_PREFIX/ENV" --query Parameter.Value --output text --region "$REGION" 2>/dev/null || true)"
DEBUG_VAL="$(aws ssm get-parameter --name "$PARAM_PREFIX/DEBUG" --query Parameter.Value --output text --region "$REGION" 2>/dev/null || true)"

SMTP_HOST="$(aws ssm get-parameter --name "$PARAM_PREFIX/SMTP_HOST" --query Parameter.Value --output text --region "$REGION" 2>/dev/null || true)"
SMTP_PORT="$(aws ssm get-parameter --name "$PARAM_PREFIX/SMTP_PORT" --query Parameter.Value --output text --region "$REGION" 2>/dev/null || true)"
EMAIL_FROM="$(aws ssm get-parameter --name "$PARAM_PREFIX/EMAIL_FROM" --query Parameter.Value --output text --region "$REGION" 2>/dev/null || true)"

echo "==> Write .env.prod"
mkdir -p "$DEPLOY_DIR"

cat > "$DEPLOY_DIR/.env.prod" <<EOF
DATABASE_URL=$DATABASE_URL
SECRET_KEY=$SECRET_KEY
EOF

if [ -n "$FRONTEND_URL" ]; then echo "FRONTEND_URL=$FRONTEND_URL" >> "$DEPLOY_DIR/.env.prod"; fi
if [ -n "$ENV_VAL" ]; then echo "ENV=$ENV_VAL" >> "$DEPLOY_DIR/.env.prod"; fi
if [ -n "$DEBUG_VAL" ]; then echo "DEBUG=$DEBUG_VAL" >> "$DEPLOY_DIR/.env.prod"; fi
if [ -n "$SMTP_HOST" ]; then echo "SMTP_HOST=$SMTP_HOST" >> "$DEPLOY_DIR/.env.prod"; fi
if [ -n "$SMTP_PORT" ]; then echo "SMTP_PORT=$SMTP_PORT" >> "$DEPLOY_DIR/.env.prod"; fi
if [ -n "$EMAIL_FROM" ]; then echo "EMAIL_FROM=$EMAIL_FROM" >> "$DEPLOY_DIR/.env.prod"; fi

chown ec2-user:ec2-user "$DEPLOY_DIR/.env.prod"
chmod 600 "$DEPLOY_DIR/.env.prod"

echo "==> Boot app"
sleep 5
su - ec2-user -c "cd $DEPLOY_DIR && docker compose -f docker-compose.prod.yml pull"
su - ec2-user -c "cd $DEPLOY_DIR && docker compose -f docker-compose.prod.yml up -d"

echo "==> Done"





